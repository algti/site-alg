# Exemplo de server block (adapte domínio, certificados e porta do backend).
# O build do frontend gera um index.html por rota (pré-renderização) e um 404.html.

server {
    listen 443 ssl http2;
    server_name algti.com.br www.algti.com.br;

    # ssl_certificate     /etc/letsencrypt/live/algti.com.br/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/algti.com.br/privkey.pem;

    root /var/www/alg-website/frontend/build;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Arquivos com hash no nome podem ser cacheados por muito tempo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API (FastAPI)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # o backend usa o último valor de X-Forwarded-For (o IP real adicionado pelo nginx)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8000;
    }

    # Rotas pré-renderizadas; qualquer outra devolve 404 real com a página amigável
    location / {
        try_files $uri $uri/index.html =404;
    }

    error_page 404 /404.html;
}
