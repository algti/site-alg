# ALG Tech Hub - Configuração do backend
# Copie para .env e preencha. NUNCA commite o arquivo .env.

# MySQL
MYSQL_HOST=localhost
MYSQL_DATABASE=alg_tech_hub
MYSQL_USER=alg_app
MYSQL_PASSWORD=troque_esta_senha

# E-mail (Gmail SMTP com "Senha de App" - veja docs/GMAIL_SMTP_SETUP.md)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=contato@algti.com
EMAIL_PASS=senha_de_app_de_16_caracteres
COMPANY_EMAIL=contato@algti.com

# CORS: lista JSON ou separada por vírgula
CORS_ORIGINS=["https://algti.com.br", "https://algti.com", "http://localhost:5173"]

# Token para consultar GET /api/contact (header X-Admin-Token).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Se ficar vazio, a rota administrativa fica desabilitada.
ADMIN_TOKEN=

# Anti-spam: máximo de envios por IP dentro da janela (segundos)
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600

# Aplicação
DEBUG=False
LOG_LEVEL=INFO
PORT=8000
