# ALG Tech Hub - Configurações de Desenvolvimento
# Para testar sem MySQL local

# MySQL Database Configuration (será ignorado se não conectar)
MYSQL_HOST=localhost
MYSQL_DATABASE=alg_tech_hub
MYSQL_USER=root
MYSQL_PASSWORD=

# Email Configuration (funcionará como fallback)
SMTP_SERVER=mail.algti.com.br
SMTP_PORT=587
EMAIL_USER=contato@algti.com.br
EMAIL_PASS=!@ALG@sw!
COMPANY_EMAIL=contato@algti.com.br

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Application Settings
DEBUG=True
LOG_LEVEL=DEBUG

# Security
SECRET_KEY=dev_key_not_for_production
JWT_SECRET=dev_jwt_key

# API Settings
API_VERSION=2.0.0
MAX_CONNECTIONS=5
CONNECTION_TIMEOUT=10

# WhatsApp Configuration
WHATSAPP_BUSINESS_PHONE=+5543999625471
