# Configurações MySQL - ALG Tech Hub
# Copie este arquivo para .env e ajuste as configurações

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_DATABASE=alg_tech_hub
MYSQL_USER=alg_app
MYSQL_PASSWORD=senha_segura_aqui

# Para cPanel Hostgator, use:
# MYSQL_HOST=localhost
# MYSQL_DATABASE=seu_usuario_algtech
# MYSQL_USER=seu_usuario_mysql
# MYSQL_PASSWORD=sua_senha_mysql

# Email Configuration (SMTP)
SMTP_SERVER=mail.algti.com.br
SMTP_PORT=587
EMAIL_USER=contato@algti.com.br
EMAIL_PASS=sua_senha_email

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
CORS_ORIGINS=["https://algti.com.br", "http://localhost:3000"]

# Security
SECRET_KEY=sua_chave_secreta_muito_segura_aqui
JWT_SECRET=outra_chave_secreta_para_jwt

# API Settings
API_VERSION=2.0.0
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT=30
